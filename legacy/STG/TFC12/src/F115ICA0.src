               Move  'VAR1'              To R7918030-In-Variable-Key (1)06510005
               Move  W-Table-Name        To R7918030-In-Variable-Data(1)06520005
               Move  'VAR2'              To R7918030-In-Variable-Key (2)06530005
               Move  FK-OAKO-FinInst-ID  To WD-Fin-Inst-ID              06540000
               Move  FK-TFMC-Contr-No    To WD-Contract-No              06550000
               String WD-Fin-Inst-ID           Delimited by size        06560000
                      '/'                      Delimited by size        06570010
                      FK-TFMC-Contr-Type       Delimited by space       06580000
                      WD-Contract-No           Delimited by space       06590000
                      '/'                      Delimited by size        06600010
                      TFCA-Currency            Delimited by space       06610000
                                       Into R7918030-In-Variable-Data(2)06620005
               End-String                                               06630000
               Perform Z000-Error-Message                               06640000
               Set   R7919999-Return-Error                              06650005
                                         To    True                     06660005
      *                                                                 06670000
           End-Evaluate                                                 06680000
      *                                                                 06690000
           .                                                            06700000

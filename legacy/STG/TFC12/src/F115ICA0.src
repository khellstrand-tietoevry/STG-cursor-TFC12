      *################################################################.02200000
       Linkage Section.                                                 02210000
      *                                                                 02220000
       01  L-Ext-IO-Area                 Pic  X(560).                   02230000
       Copy R7919999.                                                   02240000
      *                                                                 02250000
      *################################################################.02260000
       Procedure Division                Using L-Ext-IO-Area            02270000
                                               R7919999-Error-Area.     02280005
      *                                                                 02290000
       A000-Main                         Section.                       02300000
      *                                                                 02310000
           Perform B000-Initialize                                      02320000
      *                                                                 02330000
           Evaluate True                                                02340000
             When SW-IA-Initialize                                      02350000
               Continue                                                 02360000
      *                                                                 02370000
             When Other                                                 02380000
               Perform ZI00-Conv-Input-Version                          02390015
               Perform C000-Interface                                   02400000
               Perform ZO00-Conv-Output-Version                         02410015
      *                                                                 02420000
           End-Evaluate                                                 02430000
      *                                                                 02440000
           Goback.                                                      02450000
      *################################################################*02460000
       B000-Initialize                   Section.                       02470000
      *                                                                 02480000
           Set   R7919999-Return-OK      To    True                     02490005
      *                                                                 02500000
           Evaluate True                                                02510000
             When L-Ext-IO-Area (1:10)   =     'INITIALIZE'             02520000
               Set   Sw-IA-Initialize    To    True                     02530000
             When Other                                                 02540000
               Move  Space               To    W-Input-Action           02550000
           End-Evaluate                                                 02560000
      *                                                                 02570000
           Compute  W-Max-Occ-WS-Tab                                    02580000
               =    Length               Of    WS-DB2-Table             02590000
               /    Length               Of    WS-DB2-Row               02600000
      *                                                                 02610000
           If  Sw-IA-Initialize                                         02620000
           or  WS-DB2-Row-Status (1)     Not   Numeric                  02630016
               Initialize                      W-Storage                02640000
               Move  +0                  To    Ind-WS-Put               02650000
           End-If                                                       02660000
      *                                                                 02670000
           If  WC-Row-No                 Not   Numeric                  02680000
           or  WC-Total-No-Of-Rows       Not   Numeric                  02690000
               Initialize                      WC-Counters              02700000
           End-If                                                       02710000
      *                                                                 02720000
           Evaluate True                                                02730007
             When Not R115X000-Is-Initiated                             02740007
               Initialize                      R115X000-External-Data   02750007
             When Not R115X000-Version                                  02760007
               Initialize                      R7918030-ErrorMessage    02770007
               Move  'GL-VERSION-INVALID'                               02780007
                                         To    R7918030-In-MessageCode  02790007
               Move  'VAR1'              To R7918030-In-Variable-Key (1)02800007
               Move  R115X000-Version-No To R7918030-In-Variable-Data(1)02810007
               Move  'VAR2'              To R7918030-In-Variable-Key (2)02820007
               Move  'R115X000'          To R7918030-In-Variable-Data(2)02830007
               Perform Z000-Error-Message                               02840007
               Move  'B001'              To    R7919999-Paragraph       02850007
               Perform Z900-Abend                                       02860007
           End-Evaluate                                                 02870007
      *                                                                 02880007
           .                                                            02890000
      *################################################################.02900000
       C000-Interface                    Section.                       02910000
      *                                                                 02920000
           Perform C100-Verify                                          02930026
      *                                                                 02940026
           Evaluate True                                                02950000
             When R115ICA0-In-Get-1st                                   02960000
               Perform C200-Initialize-Output                           02970026
               Perform D000-Get-1st                                     02980000
               Perform E000-Get-Next                                    02990000
      *                                                                 03000000
             When R115ICA0-In-Get-Next                                  03010000
               Perform C200-Initialize-Output                           03020026
               Perform E000-Get-Next                                    03030000
      *                                                                 03040000
             When R115ICA0-In-Select                                    03050000
               Perform C200-Initialize-Output                           03060026
               Perform F000-Select                                      03070000
      *                                                                 03080000
             When R115ICA0-In-Insert                                    03090000
               Perform G000-Insert                                      03100000
      *                                                                 03110000
             When R115ICA0-In-Update                                    03120000
               Perform H000-Update                                      03130000
      *                                                                 03140000
             When R115ICA0-In-Delete                                    03150000
               Perform I000-Delete                                      03160000
      *                                                                 03170000
             When Other                                                 03180000
               Initialize                      R7918030-ErrorMessage    03190005
               Move  'GL-IN-AKSJON-UV'   To    R7918030-In-MessageCode  03200005
               Move  'VAR1'              To R7918030-In-Variable-Key (1)03210005
               Move  R115ICA0-In-Action  To R7918030-In-Variable-Data(1)03220005
               Perform Z000-Error-Message                               03230000
               Move  'C001'              To    R7919999-Paragraph       03240005
               Perform Z900-Abend                                       03250000
      *                                                                 03260000
           End-Evaluate                                                 03270000
      *                                                                 03280000
           .                                                            03290000
      *################################################################.03300000
       C100-Verify                       Section.                       03310026
      *                                                                 03320000
           Evaluate True                                                03330028
             When R115ICA0-In-Actual                                    03340028
               Set   SW-Table-Actual     To    True                     03350028
      *                                                                 03360028
             When R115ICA0-In-Work                                      03370028
               Set   SW-Table-Work       To    True                     03380028
      *                                                                 03390028
             When other                                                 03400028

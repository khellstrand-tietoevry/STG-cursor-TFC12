               Set   WS-Cursor-End       To    True                     06440000
               If  WC-Row-No             =     +0                       06450000
                 Then                                                   06460000
                   Initialize                  R7918030-ErrorMessage    06470000
                   Move  'DB-FOREKOMST-NF'                              06480000
                                         To    R7918030-In-MessageCode  06490000
                   Move  'VAR1'          To R7918030-In-Variable-Key (1)06500000
                   Move  W-Table-Name    To R7918030-In-Variable-Data(1)06510000
                   Perform Z000-Error-Message                           06520000
                 Else                                                   06530000
                   Initialize                  R7918030-ErrorMessage    06540000
                   Move  'DB-LEST-SISTE' To    R7918030-In-MessageCode  06550000
                   Move  'VAR1'          To R7918030-In-Variable-Key (1)06560000
                   Move  W-Table-Name    To R7918030-In-Variable-Data(1)06570000
                   Perform Z000-Error-Message                           06580000

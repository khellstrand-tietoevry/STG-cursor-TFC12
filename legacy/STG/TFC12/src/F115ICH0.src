               Set   R7919999-Return-Error                              09880000
                                         To    True                     09890000
                                                                        09900000
           End-Evaluate                                                 09910000
      *                                                                 09920000
           .                                                            09930000
      *################################################################.09940000
       H200-Update-Row                   Section.                       09950000
      *                                                                 09960000
           Initialize                          R115ICHS-SQL-Submodules  09970000
           Set   R115ICHS-Version        To    True                     09980000
           Set   R115ICHS-In-Update      To    True                     09990000
           Move  R115ICH0-In-Table-Version                              10000010
                                         To    R115ICHS-In-Table-Version10010010
      *                                                                 10020000
           Call  'F115ICHU'              Using R115ICHS-SQL-Submodules  10030000
                                               DCLTF-Main-Charge        10040000
                                               R7919999-Error-Area      10050000
           End-Call                                                     10060000
      *                                                                 10070000
           Evaluate True                                                10080000
             When R7919999-Return-OK                                    10090000
               Continue                                                 10100000
      *                                                                 10110000
             When R7919999-Return-Error                                 10120000
               Continue                                                 10130000
      *                                                                 10140000
             When other                                                 10150000
               Move  'H201'              To    R7919999-Paragraph       10160000
               Perform Z900-Abend                                       10170000
      *                                                                 10180000
           End-Evaluate                                                 10190000
      *                                                                 10200000
           .                                                            10210000
      *################################################################.10220000
       I000-Delete                       Section.                       10230000
      *                                                                 10240000
           Perform F100-Prepare-Qualification                           10250000
           Perform I200-Delete-Row                                      10260000
      *                                                                 10270000
           Perform L300-Remove-DCL                                      10280000
      *                                                                 10290000
           .                                                            10300000
      *################################################################.10310000
       I200-Delete-Row                   Section.                       10320000
      *                                                                 10330000
           Initialize                          R115ICHS-SQL-Submodules  10340000
           Set   R115ICHS-Version        To    True                     10350000
           Set   R115ICHS-In-Delete      To    True                     10360000
           Move  R115ICH0-In-Table-Version                              10370010
                                         To    R115ICHS-In-Table-Version10380010
      *                                                                 10390000
           Call  'F115ICHU'              Using R115ICHS-SQL-Submodules  10400000
                                               DCLTF-Main-Charge        10410000
                                               R7919999-Error-Area      10420000
           End-Call                                                     10430000
      *                                                                 10440000
           Evaluate True                                                10450000
             When R7919999-Return-OK                                    10460000
               Continue                                                 10470000
      *                                                                 10480000
             When R7919999-Return-Error                                 10490000
               Continue                                                 10500000
      *                                                                 10510000
             When other                                                 10520000
               Move  'I201'              To    R7919999-Paragraph       10530000
               Perform Z900-Abend                                       10540000
      *                                                                 10550000
           End-Evaluate                                                 10560000
      *                                                                 10570000
           .                                                            10580000
      *################################################################.10590000
       J000-Get-Columns                  Section.                       10600000
      *                                                                 10610000
           Perform J100-Move-DCL-To-Output                              10620000
      *                                                                 10630000
           .                                                            10640000
      *################################################################.10650000
       J100-Move-DCL-To-Output           Section.                       10660000
      *                                                                 10670000
      * PLEASE REMEMBER:                                                10680007
      *    When you modify the code in this section, you need to do     10690007
      *    the same modifications in module F115ACH0 - E500-section.    10700007
      *                                                                 10710007
           Move  FK-OAKO-FinInst-ID      To    R115ICH0-Fin-Inst-ID     10720000
           Move  FK-TFMC-Contr-Type      To    R115ICH0-Contract-Type   10730000
           Move  FK-TFMC-Contr-No        To    R115ICH0-Contract-No     10740000
      *                                                                 10750000
           Move  FK-OAKO-FinInst-ID      To    W-Fin-Inst-ID            10760000
           Perform N200-Fetch-Fin-Inst-No                               10770000
           Move  W-Fin-Inst-No           To    R115ICH0-Fin-Inst-No     10780000
      *                                                                 10790000
           Move  FK-TFCA-Currency        To    R115ICH0-CA-Currency     10800003
           Move  FK-TFPA-Seq-No          To    R115ICH0-PA-Seq-No       10810003
           Move  FK-KFTY-Role-Type       To    R115ICH0-RP-Role-Type    10820003
      *                                                                 10830003
           Move  FK-TFCT-Type            To    R115ICH0-Charge-Type     10840000
           Move  TFCH-Seq-No             To    R115ICH0-CH-Seq-No       10850000
      *                                                                 10860000
           Move  TFCH-Charge-Amount      To    R115ICH0-Charge-Amount   10870000
           Move  TFCH-Currency           To    R115ICH0-Currency        10880000
           Move  TFCH-Charge-Pct         To    R115ICH0-Charge-Pct      10890013
           If TFCH-Charge-Text-Len > 0                                  10890123
             Move  TFCH-Charge-Text-Text To    R115ICH0-Charge-Text     10891023
           End-If                                                       10891123
           Move  TFCH-Charge-Text-Len    To    R115ICH0-Text-Len        10892021
      *                                                                 10900000
      * Info about the cursor:                                          10910000
      *                                                                 10920000
           Move  WC-Row-No               To    R115ICH0-Out-Row-No      10930000
           Move  WC-Total-No-Of-Rows     To    R115ICH0-Out-Total-Rows  10940000
      *                                                                 10950000
           .                                                            10960000
      *################################################################.10970000
       L100-Store-DCL                    Section.                       10980000
      *                                                                 10990000
      * We might already have this row in storage.                      11000002
      *                                                                 11010002
           Perform L200-Find-DCL                                        11020002
      *                                                                 11030002
           If  Ind-WS                    >     W-Max-Occ-WS-Tab         11040002
           or  WS-DB2-Not-Read (Ind-WS)                                 11050002
             Then                                                       11060002
      *        If we have reached the end of the storage-table,         11070002
      *        we start on the beginning.                               11080002
      *        This way, we always keep the "newest" occurrences.       11090002
               Add   +1                  To    Ind-WS-Put               11100002
               If  Ind-WS-Put            >     W-Max-Occ-WS-Tab         11110002
                   Move  +1              To    Ind-WS-Put               11120002
               End-If                                                   11130002
               Move  Ind-WS-Put          To    Ind-WS                   11140002
             Else                                                       11150002
               Move  Ind-WS              To    Ind-WS-Put               11160002
           End-If                                                       11170002
      *                                                                 11180002
      * We store the identification.                                    11190000
      *                                                                 11200000
           Move  R115ICH0-In-Table-Version                              11210010
                                         To    WS-DB2-Tbl-Version       11220010
                                                            (Ind-WS-Put)11230010
           Move  FK-OAKO-FinInst-ID      To    WS-DB2-Fin-Inst-ID       11240000
                                                            (Ind-WS-Put)11250000
           Move  FK-TFMC-Contr-Type      To    WS-DB2-Contract-Type     11260000
                                                            (Ind-WS-Put)11270000
           Move  FK-TFMC-Contr-No        To    WS-DB2-Contract-No       11280000
                                                            (Ind-WS-Put)11290000
           Move  FK-TFCA-Currency        To    WS-DB2-CA-Currency       11300003
                                                            (Ind-WS-Put)11310000
           Move  FK-TFPA-Seq-No          To    WS-DB2-PA-Seq-No         11320003
                                                            (Ind-WS-Put)11330003
           Move  FK-KFTY-Role-Type       To    WS-DB2-RP-Role-Type      11340003
                                                            (Ind-WS-Put)11350003
           Move  FK-TFCT-Type            To    WS-DB2-Charge-Type       11360003
                                                            (Ind-WS-Put)11370003
           Move  TFCH-Seq-No             To    WS-DB2-CH-Seq-No         11380000
                                                            (Ind-WS-Put)11390000
      *                                                                 11400000
      * The DCL is stored if found, the status is set.                  11410000
      *                                                                 11420000
           Evaluate True                                                11430000
             When Length                 Of    DCLTF-Main-Charge        11440000
                > Length                 Of    WS-DB2-DCL               11450000
               Move  Length              Of    DCLTF-Main-Charge        11460000
                                         To    WD-Length                11470000
               Initialize                      R7918030-ErrorMessage    11480000
               Move  'GL-WL-DCL-UTVIDES' To    R7918030-In-MessageCode  11490000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)11500000
               Move  WD-Length           To R7918030-In-Variable-Data(1)11510000
               Perform Z000-Error-Message                               11520000
               Move  'L101'              To    R7919999-Paragraph       11530000
               Perform Z900-Abend                                       11540000
      *                                                                 11550000
             When R7919999-Return-Error                                 11560000
               Set   WS-DB2-Not-Found (Ind-WS-Put)                      11570000
                                         To    True                     11580000
      *                                                                 11590000
             When other                                                 11600000
               Move  DCLTF-Main-Charge                                  11610000
                                         To    WS-DB2-DCL   (Ind-WS-Put)11620000
               Set   WS-DB2-Read (Ind-WS-Put)                           11630000
                                         To    True                     11640000
      *                                                                 11650000
           End-Evaluate                                                 11660000
      *                                                                 11670000
           .                                                            11680000
      *################################################################.11690000
       L200-Find-DCL                     Section.                       11700000
      *                                                                 11710000
           Perform Varying Ind-WS                                       11720000
                   From  +1              By    +1                       11730000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         11740000
                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    11750010
                                         =     R115ICH0-In-Table-Version11760010
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    11770010
                                         =     FK-OAKO-FinInst-ID       11780000
                     and WS-DB2-Contract-Type (Ind-WS)                  11790000
                                         =     FK-TFMC-Contr-Type       11800000
                     and WS-DB2-Contract-No (Ind-WS)                    11810000
                                         =     FK-TFMC-Contr-No         11820000
                     and WS-DB2-CA-Currency (Ind-WS)                    11830003
                                         =     FK-TFCA-Currency         11840003
                     and WS-DB2-PA-Seq-No (Ind-WS)                      11850003
                                         =     FK-TFPA-Seq-No           11860003
                     and WS-DB2-RP-Role-Type (Ind-WS)                   11870003
                                         =     FK-KFTY-Role-Type        11880003
                     and WS-DB2-Charge-Type (Ind-WS)                    11890003
                                         =     FK-TFCT-Type             11900003
                     and WS-DB2-CH-Seq-No (Ind-WS)                      11910000
                                         =     TFCH-Seq-No )            11920000
           End-Perform                                                  11930000
      *                                                                 11940000
           .                                                            11950000
      *################################################################*11960000
       L300-Remove-DCL                   Section.                       11970000
      *                                                                 11980000
           Perform Varying Ind-WS                                       11990000
                   From  +1              By    +1                       12000000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         12010000
                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    12020010
                                         =     R115ICH0-In-Table-Version12030010
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    12040010
                                         =     FK-OAKO-FinInst-ID       12050000
                     and WS-DB2-Contract-Type (Ind-WS)                  12060000
                                         =     FK-TFMC-Contr-Type       12070000
                     and WS-DB2-Contract-No (Ind-WS)                    12080000
                                         =     FK-TFMC-Contr-No         12090000
                     and WS-DB2-CA-Currency (Ind-WS)                    12100003
                                         =     FK-TFCA-Currency         12110003
                     and WS-DB2-PA-Seq-No (Ind-WS)                      12120003
                                         =     FK-TFPA-Seq-No           12130003
                     and WS-DB2-RP-Role-Type (Ind-WS)                   12140003
                                         =     FK-KFTY-Role-Type        12150003
                     and WS-DB2-Charge-Type (Ind-WS)                    12160000
                                         =     FK-TFCT-Type             12170000
                     and WS-DB2-CH-Seq-No (Ind-WS)                      12180000
                                         =     TFCH-Seq-No )            12190000
           End-Perform                                                  12200000
      *                                                                 12210000
           Evaluate True                                                12220000
             When Ind-WS                 >     W-Max-Occ-WS-Tab         12230000
               Continue                                                 12240000
      *                                                                 12250000
             When other                                                 12260000
               Initialize                      WS-DB2-Row (Ind-WS)      12270000
      *                                                                 12280000
           End-Evaluate                                                 12290000
      *                                                                 12300000
           .                                                            12310000
      *################################################################*12320000
       N100-Fetch-Fin-Inst-ID            Section.                       12330000
      *                                                                 12340000
           Move  W-Fin-Inst-No (1:4)     To    W-Tmp-Konsern-Nr         12350000
      *                                                                 12360000
           If  Not R5879010-Versjon                                     12370000
           or  R5879010-In-Konsernnr     Not = W-Tmp-Konsern-Nr         12380000
      *                                                                 12390000
               Initialize                      R5879010-Konsern         12400000
               Set   R5879010-Versjon    To    True                     12410000
               Set   R5879010-In-Select  To    True                     12420000
               Move  W-Tmp-Konsern-Nr    To    R5879010-In-Konsernnr    12430000
               Call  'F5879010'          Using R5879010-Konsern         12440000
                                               R7919999-Error-Area      12450000
               End-Call                                                 12460000
               If  Not R7919999-Return-OK                               12470000
                   Move  'N101'          To    R7919999-Paragraph       12480000
                   Perform Z900-Abend                                   12490000
               End-If                                                   12500000
      *                                                                 12510000
           End-If                                                       12520000
      *                                                                 12530000
           Move  R5879010-Ut-KO-Konsern-Id                              12540000
                                         To    W-Fin-Inst-ID            12550000
      *                                                                 12560000
           .                                                            12570000
      *################################################################*12580000
       N200-Fetch-Fin-Inst-No            Section.                       12590000
      *                                                                 12600000
           If  Not R5879010-Versjon                                     12610000
           or  R5879010-In-Konsern-ID    Not = W-Fin-Inst-ID            12620000
      *                                                                 12630000
               Initialize                      R5879010-Konsern         12640000
               Set   R5879010-Versjon    To    True                     12650000
               Set   R5879010-In-Select  To    True                     12660000
               Move  W-Fin-Inst-ID       To    R5879010-In-Konsern-ID   12670000
               Call  'F5879010'          Using R5879010-Konsern         12680000
                                               R7919999-Error-Area      12690000
               End-Call                                                 12700000
               If  Not R7919999-Return-OK                               12710000
                   Move  'N201'          To    R7919999-Paragraph       12720000
                   Perform Z900-Abend                                   12730000
               End-If                                                   12740000
      *                                                                 12750000
           End-If                                                       12760000
      *                                                                 12770000
           Move  R5879010-Ut-KO-Konsernnummer                           12780000
                                         To    W-Tmp-Konsern-Nr         12790000
           Move  W-Tmp-Konsern-Nr        To    W-Fin-Inst-No            12800000
      *                                                                 12810000
           .                                                            12820000
      *################################################################*12830000
       ZI00-Conv-Input-Version           Section.                       12840000
      *                                                                 12850000
      * Version control.                                                12860000
      * If conversion is needed, we call the conversion module.         12870000
      *                                                                 12880000
           Set   R115ICH0-Version        To    True                     12890000
           Move  Length                  Of    R115ICH0-Main-Charge     12900000
                                         To    W-IO-Length              12910000
      *                                                                 12920000
           Evaluate True                                                12930000
             When L-Ext-IO-Area (1:8)    =     R115ICH0-Version-No      12940000
             and  Length                 Of    L-Ext-IO-Area            12950000
                                         Not < W-IO-Length              12960000
               Move  L-Ext-IO-Area (1:W-IO-Length)                      12970000
                                         To    W-Int-IO-Area            12980000
      *                                                                 12990000
             When Other                                                 13000000
               Call  'F115I999'                                         13010000
                   Using By Content      'F115ICH0 '                    13020000
                                         'INPUT '                       13030000
                         By Reference    L-Ext-IO-Area                  13040000
                                         W-Int-IO-Area                  13050000
                                         R7919999-Error-Area            13060000
               End-Call                                                 13070000
      *                                                                 13080000
               If  R7919999-Return-Abend                                13090000
                   Move  'ZI03'          To    R7919999-Paragraph       13100000
                   Perform Z900-Abend                                   13110000
               End-If                                                   13120000
      *                                                                 13130000
           End-Evaluate                                                 13140000
      *                                                                 13150000
           .                                                            13160000
      *################################################################*13170000
       ZO00-Conv-Output-Version          Section.                       13180000
      *                                                                 13190000
      * Version control.                                                13200000
      * If conversion is needed, we call the conversion module.         13210000
      *                                                                 13220000
           Evaluate True                                                13230000
             When L-Ext-IO-Area (1:8)    =     R115ICH0-Version-No      13240000
             and  Length                 Of    L-Ext-IO-Area            13250000
                                         Not < W-IO-Length              13260000
               Move  W-Int-IO-Area       To    L-Ext-IO-Area            13270000
                                                         (1:W-IO-Length)13280000
      *                                                                 13290000
             When Other                                                 13300000
               Call  'F115I999'                                         13310000
                   Using By Content      'F115ICH0 '                    13320000
                                         'OUTPUT '                      13330000
                         By Reference    L-Ext-IO-Area                  13340000
                                         W-Int-IO-Area                  13350000
                                         R7919999-Error-Area            13360000
               End-Call                                                 13370000
      *                                                                 13380000
               If  R7919999-Return-Abend                                13390000
                   Move  'ZO01'          To    R7919999-Paragraph       13400000
                   Perform Z900-Abend                                   13410000
               End-If                                                   13420000
      *                                                                 13430000
           End-Evaluate                                                 13440000
      *                                                                 13450000
           .                                                            13460000
      *################################################################*13470000
       Z000-Error-Message                Section.                       13480000
      *                                                                 13490000
           Set   R7918030-Version        To    True                     13500000
      *                                                                 13510000
           Move  'TF'                    To    R7918030-In-System-ID    13520000
           Move  R115X000-Fin-Inst-No    To    R7918030-In-Fin-Inst-No  13530000
           Move  R115X000-FI-Language-639-1                             13540000
                                         To    R7918030-In-Language     13550000
           If  R115X000-Trace-On                                        13560000
               Set   R7918030-In-Log-Yes To    True                     13570000
           End-If                                                       13580000
      *                                                                 13590000
           Call  'F7918030'              Using R7918030-ErrorMessage    13600000
           End-Call                                                     13610000
      *                                                                 13620000
           Move  R7918030-Out-MessageText                               13630000
                                         To    R7919999-Message         13640000
      *                                                                 13650000
           .                                                            13660000
      *################################################################*13670000
       Z900-Abend                        Section.                       13680000
      *                                                                 13690000
           If  R7919999-Return-Code      Not   Numeric                  13700000
           or  Not R7919999-Return-Abend                                13710000
               Move  +0                  To    R7919999-Module-Ind      13720000
           End-If                                                       13730000
      *                                                                 13740000
           Add   +1                      To    R7919999-Module-Ind      13750000
      *                                                                 13760000
           If  R7919999-Module-Ind       Not >                          13770000
                             ( Length    Of    R7919999-Module-Tab      13780000
                             / Length    Of    R7919999-Module-Element )13790000
               Move  'F115ICH0'          To    R7919999-Module-Name     13800000
                                                   (R7919999-Module-Ind)13810000
               Move  R7919999-Paragraph  To    R7919999-Module-Para     13820000
                                                   (R7919999-Module-Ind)13830000
           End-If                                                       13840000
      *                                                                 13850000
           Set   R7919999-Return-Abend   To    TRUE                     13860000
      *                                                                 13870000
           Goback.                                                      13880000

      *################################################################.08979423
       H100-Check-Qualification          Section.                       08980000
      *                                                                 08990000
           Evaluate True                                                09000000
             When R115IPA0-Fin-Inst-ID   Not = +0                       09010000
               Continue                                                 09020000
                                                                        09030000
             When R115IPA0-Fin-Inst-No   Not = Space                    09040000
               Move  R115IPA0-Fin-Inst-No                               09050000
                                         To    W-Fin-Inst-No            09060000
               Perform N100-Fetch-Fin-Inst-ID                           09070000
               Move  W-Fin-Inst-ID       To    R115IPA0-Fin-Inst-ID     09080000
                                                                        09090000
             When R115IPA0-In-Fin-Inst-Id Not = +0                      09100000
               Move R115IPA0-In-Fin-Inst-ID                             09110000
                                         To    R115IPA0-Fin-Inst-ID     09120000
                                                                        09130000
             When R115IPA0-In-Fin-Inst-No                               09140000
                                         Not = Space                    09150000
               Move  R115IPA0-In-Fin-Inst-No                            09160000
                                         To    W-Fin-Inst-No            09170000
               Perform N100-Fetch-Fin-Inst-ID                           09180000
               Move  W-Fin-Inst-ID       To    R115IPA0-Fin-Inst-ID     09190000
                                                                        09200000
             When other                                                 09210000
               Initialize                      R7918030-ErrorMessage    09220000
               Move  'TF-FIN-INST-MISSING'                              09230000
                                         To    R7918030-In-MessageCode  09240000
               Perform Z000-Error-Message                               09250000
               Set   R7919999-Return-Error                              09260000
                                         To    True                     09270000
                                                                        09280000
           End-Evaluate                                                 09290000
      *                                                                 09300000
           Evaluate True                                                09310000
             When R115IPA0-Contract-Type Not = Space                    09320000
               Continue                                                 09330000
                                                                        09340000
             When R115IPA0-In-Contract-Type                             09350000
                                         Not = Space                    09360000
               Move R115IPA0-In-Contract-Type                           09370000
                                         To    R115IPA0-Contract-Type   09380000
                                                                        09390000
             When other                                                 09400000
               Initialize                      R7918030-ErrorMessage    09410000
               Move  'TF-CONTRACT-MISSING'                              09420000
                                         To    R7918030-In-MessageCode  09430000
               Perform Z000-Error-Message                               09440000
               Set   R7919999-Return-Error                              09450000
                                         To    True                     09460000
                                                                        09470000
           End-Evaluate                                                 09480000
      *                                                                 09490000
           Evaluate True                                                09500000
             When R115IPA0-Contract-No   Not = +0                       09510000
               Continue                                                 09520000
                                                                        09530000
             When R115IPA0-In-Contract-No                               09540000
                                         Not = +0                       09550000
               Move R115IPA0-In-Contract-No                             09560000
                                         To    R115IPA0-Contract-No     09570000
                                                                        09580000
             When other                                                 09590000
               Initialize                      R7918030-ErrorMessage    09600000
               Move  'TF-CONTRACT-MISSING'                              09610000
                                         To    R7918030-In-MessageCode  09620000
               Perform Z000-Error-Message                               09630000
               Set   R7919999-Return-Error                              09640000
                                         To    True                     09650000
                                                                        09660000
           End-Evaluate                                                 09670000
      *                                                                 09680000
           Evaluate True                                                09690000
             When R115IPA0-CA-Currency   Not = Space                    09700000
               Continue                                                 09710000
                                                                        09720000
             When R115IPA0-In-CA-Currency                               09730000
                                         Not = Space                    09740000
               Move R115IPA0-In-CA-Currency                             09750000
                                         To    R115IPA0-CA-Currency     09760000
                                                                        09770000
             When other                                                 09780000
               Initialize                      R7918030-ErrorMessage    09790000
               Move  'TF-PART-AMOUNT-MISSING'                           09800000
                                         To    R7918030-In-MessageCode  09810000
               Perform Z000-Error-Message                               09820000
               Set   R7919999-Return-Error                              09830000
                                         To    True                     09840000
                                                                        09850000
           End-Evaluate                                                 09860000
      *                                                                 09870000
           Evaluate True                                                09880000
             When R115IPA0-PA-Seq-No     Not = +0                       09890000
               Continue                                                 09900000
                                                                        09910000
             When R115IPA0-In-PA-Seq-No  Not = +0                       09920000
               Move R115IPA0-In-PA-Seq-No                               09930000
                                         To    R115IPA0-PA-Seq-No       09940000
                                                                        09950000
             When other                                                 09960000
               Initialize                      R7918030-ErrorMessage    09970000
               Move  'TF-PART-AMOUNT-MISSING'                           09980000
                                         To    R7918030-In-MessageCode  09990000
               Perform Z000-Error-Message                               10000000
               Set   R7919999-Return-Error                              10010000
                                         To    True                     10020000
                                                                        10030000
           End-Evaluate                                                 10040000
      *                                                                 10050000
           .                                                            10060000
      *################################################################.10070000
       H200-Update-Row                   Section.                       10080000
      *                                                                 10090000
           Initialize                          R115IPAS-SQL-Submodules  10100000
           Set   R115IPAS-Version        To    True                     10110000
           Set   R115IPAS-In-Update      To    True                     10120000
           Move  R115IPA0-In-Table-Version                              10130011
                                         To    R115IPAS-In-Table-Version10140011
      *                                                                 10150000
           Call  'F115IPAU'              Using R115IPAS-SQL-Submodules  10160000
                                               DCLTF-Part-Amount        10170000
                                               R7919999-Error-Area      10180000
           End-Call                                                     10190000
      *                                                                 10200000
           Evaluate True                                                10210000
             When R7919999-Return-OK                                    10220000
               Continue                                                 10230000
      *                                                                 10240000
             When R7919999-Return-Error                                 10250000
               Continue                                                 10260000
      *                                                                 10270000
             When other                                                 10280000
               Move  'H201'              To    R7919999-Paragraph       10290000
               Perform Z900-Abend                                       10300000
      *                                                                 10310000
           End-Evaluate                                                 10320000
      *                                                                 10330000
           .                                                            10340000
      *################################################################.10341023
       H300-Update-status                Section.                       10342023
      *                                                                 10343023
           Initialize                          R115IPAS-SQL-Submodules  10344023
           Set   R115IPAS-Version        To    True                     10345023
           Set   R115IPAS-In-Upd-Status  To    True                     10346023
           Move  R115IPA0-In-Table-Version                              10347023
                                         To    R115IPAS-In-Table-Version10348023
      *                                                                 10349023
           Call  'F115IPAU'              Using R115IPAS-SQL-Submodules  10349123
                                               DCLTF-Part-Amount        10349223
                                               R7919999-Error-Area      10349323
           End-Call                                                     10349423
      *                                                                 10349523
           Evaluate True                                                10349623
             When R7919999-Return-OK                                    10349723
               Continue                                                 10349823
      *                                                                 10349923
             When R7919999-Return-Error                                 10350023
               Continue                                                 10350123
      *                                                                 10350223
             When other                                                 10350323
               Move  'H201'              To    R7919999-Paragraph       10350423
               Perform Z900-Abend                                       10350523
      *                                                                 10350623
           End-Evaluate                                                 10350723
      *                                                                 10350823
           .                                                            10350923
      *################################################################.10351023
       I000-Delete                       Section.                       10360000
      *                                                                 10370000
           Perform F100-Prepare-Qualification                           10380000
           Perform I200-Delete-Row                                      10390000
      *                                                                 10400000
           Perform L300-Remove-DCL                                      10410000
      *                                                                 10420000
           .                                                            10430000
      *################################################################.10440000
       I200-Delete-Row                   Section.                       10450000
      *                                                                 10460000
           Initialize                          R115IPAS-SQL-Submodules  10470000
           Set   R115IPAS-Version        To    True                     10480000
           Set   R115IPAS-In-Delete      To    True                     10490000
           Move  R115IPA0-In-Table-Version                              10500011
                                         To    R115IPAS-In-Table-Version10510011
      *                                                                 10520000
           Call  'F115IPAU'              Using R115IPAS-SQL-Submodules  10530000
                                               DCLTF-Part-Amount        10540000
                                               R7919999-Error-Area      10550000
           End-Call                                                     10560000
      *                                                                 10570000
           Evaluate True                                                10580000
             When R7919999-Return-OK                                    10590000
               Continue                                                 10600000
      *                                                                 10610000
             When R7919999-Return-Error                                 10620000
               Continue                                                 10630000
      *                                                                 10640000
             When other                                                 10650000
               Move  'I201'              To    R7919999-Paragraph       10660000
               Perform Z900-Abend                                       10670000
      *                                                                 10680000
           End-Evaluate                                                 10690000
      *                                                                 10700000
           .                                                            10710000
      *################################################################.10720000
       J000-Get-Columns                  Section.                       10730000
      *                                                                 10740000
           Perform J100-Move-DCL-To-Output                              10750000
      *                                                                 10760000
           .                                                            10770000
      *################################################################.10780000
       J100-Move-DCL-To-Output           Section.                       10790000
      *                                                                 10800000
           Move  FK-OAKO-FinInst-ID      To    R115IPA0-Fin-Inst-ID     10810000
           Move  FK-TFMC-Contr-Type      To    R115IPA0-Contract-Type   10820000
           Move  FK-TFMC-Contr-No        To    R115IPA0-Contract-No     10830000
           Move  FK-TFCA-Currency        To    R115IPA0-CA-Currency     10840000
           Move  TFPA-Seq-No             To    R115IPA0-PA-Seq-No       10850000
      *                                                                 10860000
           Move  TFPA-Status             To    R115IPA0-Status          10870000
           Move  TFPA-In-Progress        To    R115IPA0-In-Progress     10880000
      *                                                                 10890001
           Initialize                          R7919100-Konverter-Dato  10900001
           Set   R7919100-Versjon        To    True                     10910001
           Move  TFPA-Register-Date      To    R7919100-In-Dato-DB2     10920001
           Set   R7919100-In-Konv-Fra-DB2                               10930001
                                         To    True                     10940001
           Set   R7919100-In-Konv-Til-AMD9                              10950001
                                         To    True                     10960001
           Call  'F7919100'              Using R7919100-Konverter-Dato  10970001
                                               R7919999-Error           10980001
           End-Call                                                     10990001
           If  Not R7919999-Retur-OK                                    11000001
               Move  'J101'              To    R7919999-Paragraf        11010001
               Perform Z900-Abend                                       11020001
           End-If                                                       11030001
           Move  R7919100-Ut-Dato-AMD9   To    R115IPA0-Register-Date   11040001
      *                                                                 11050001
           Move  TFPA-User-ID            To    R115IPA0-User-ID         11060000
           Move  TFPA-Part-Amount        To    R115IPA0-Amount          11070002
           Move  TFPA-Prev-P-Amount      To    R115IPA0-Prev-Amount     11080014
           Move  TFPA-Curr-P-Amount      To    R115IPA0-Curr-Amount     11090014
           Move  TFPA-Excess-Amount      To    R115IPA0-Excess-Amount   11100016
           Move  TFPA-Incom-Swift        To    R115IPA0-Incom-Swift     11101020
           Move  TFPA-Availability       To    R115IPA0-Availability    11102022
      *                                                                 11110000
           Initialize                          R7919100-Konverter-Dato  11120014
           Set   R7919100-Versjon        To    True                     11130014
           Move  TFPA-Accept-Date        To    R7919100-In-Dato-DB2     11140014
           Set   R7919100-In-Konv-Fra-DB2                               11150014
                                         To    True                     11160014
           Set   R7919100-In-Konv-Til-AMD9                              11170014
                                         To    True                     11180014
           Call  'F7919100'              Using R7919100-Konverter-Dato  11190014
                                               R7919999-Error           11200014
           End-Call                                                     11210014
           If  Not R7919999-Retur-OK                                    11220014
               Move  'J102'              To    R7919999-Paragraf        11230014
               Perform Z900-Abend                                       11240014
           End-If                                                       11250014
           Move  R7919100-Ut-Dato-AMD9   To    R115IPA0-Accept-Date     11260014
      *                                                                 11270014
           Move  FK-OAKO-FinInst-ID      To    W-Fin-Inst-ID            11280000
           Perform N200-Fetch-Fin-Inst-No                               11290000
           Move  W-Fin-Inst-No           To    R115IPA0-Fin-Inst-No     11300000
      *                                                                 11310000
      * Info about the cursor:                                          11320000
      *                                                                 11330000
           Move  WC-Row-No               To  R115IPA0-Out-Row-No        11340000
           Move  WC-Total-No-Of-Rows     To  R115IPA0-Out-Total-Rows    11350000
      *                                                                 11360000
           .                                                            11370000
      *################################################################.11380000
       L100-Store-DCL                    Section.                       11390000
      *                                                                 11400000
      * We might already have this row in storage.                      11410000
      *                                                                 11420000
           Perform L200-Find-DCL                                        11430000
      *                                                                 11440000
           If  Ind-WS                    >     W-Max-Occ-WS-Tab         11450000
           or  WS-DB2-Not-Read (Ind-WS)                                 11460000
             Then                                                       11470000
      *        If we have reached the end of the storage-table,         11480000
      *        we start on the beginning.                               11490000
      *        This way, we always keep the "newest" occurrences.       11500000
               Add   +1                  To    Ind-WS-Put               11510000
               If  Ind-WS-Put            >     W-Max-Occ-WS-Tab         11520000
                   Move  +1              To    Ind-WS-Put               11530000
               End-If                                                   11540000
               Move  Ind-WS-Put          To    Ind-WS                   11550000
             Else                                                       11560000
               Move  Ind-WS              To    Ind-WS-Put               11570000
           End-If                                                       11580000
      *                                                                 11590000
      * We store the identification.                                    11600000
      *                                                                 11610000
           Move  R115IPA0-In-Table-Version                              11620011
                                         To    WS-DB2-Tbl-Version       11630011
                                                            (Ind-WS-Put)11640011
           Move  FK-OAKO-FinInst-ID      To    WS-DB2-Fin-Inst-ID       11650000
                                                            (Ind-WS-Put)11660000
           Move  FK-TFMC-Contr-Type      To    WS-DB2-Contract-Type     11670000
                                                            (Ind-WS-Put)11680000
           Move  FK-TFMC-Contr-No        To    WS-DB2-Contract-No       11690000
                                                            (Ind-WS-Put)11700000
           Move  FK-TFCA-Currency        To    WS-DB2-CA-Currency       11710000
                                                            (Ind-WS-Put)11720000
           Move  TFPA-Seq-No             To    WS-DB2-PA-Seq-No         11730000
                                                            (Ind-WS-Put)11740000
      *                                                                 11750000
      * The DCL is stored if found, the status is set.                  11760000
      *                                                                 11770000
           Evaluate True                                                11780000
             When Length                 Of    DCLTF-Part-Amount        11790000
                > Length                 Of    WS-DB2-DCL               11800000
               Move  Length              Of    DCLTF-Part-Amount        11810000
                                         To    WD-Length                11820000
               Initialize                      R7918030-ErrorMessage    11830000
               Move  'GL-WL-DCL-UTVIDES' To    R7918030-In-MessageCode  11840000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)11850000
               Move  WD-Length           To R7918030-In-Variable-Data(1)11860000
               Perform Z000-Error-Message                               11870000
               Move  'L101'              To    R7919999-Paragraph       11880000
               Perform Z900-Abend                                       11890000
      *                                                                 11900000
             When R7919999-Return-Error                                 11910000
               Set   WS-DB2-Not-Found (Ind-WS-Put)                      11920000
                                         To    True                     11930000
      *                                                                 11940000
             When other                                                 11950000
               Move  DCLTF-Part-Amount                                  11960000
                                         To    WS-DB2-DCL   (Ind-WS-Put)11970000
               Set   WS-DB2-Read (Ind-WS-Put)                           11980000
                                         To    True                     11990000
      *                                                                 12000000
           End-Evaluate                                                 12010000
      *                                                                 12020000
           .                                                            12030000
      *################################################################.12040000
       L200-Find-DCL                     Section.                       12050000
      *                                                                 12060000
           Perform Varying Ind-WS                                       12070000
                   From  +1              By    +1                       12080000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         12090000
                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    12100011
                                         =     R115IPA0-In-Table-Version12110011
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    12120011
                                         =     FK-OAKO-FinInst-ID       12130000
                     and WS-DB2-Contract-Type (Ind-WS)                  12140000
                                         =     FK-TFMC-Contr-Type       12150000
                     and WS-DB2-Contract-No (Ind-WS)                    12160000
                                         =     FK-TFMC-Contr-No         12170000
                     and WS-DB2-CA-Currency (Ind-WS)                    12180000
                                         =     FK-TFCA-Currency         12190000
                     and WS-DB2-PA-Seq-No (Ind-WS)                      12200000
                                         =     TFPA-Seq-No )            12210000
           End-Perform                                                  12220000
      *                                                                 12230000
           .                                                            12240000
      *################################################################*12250000
       L300-Remove-DCL                   Section.                       12260000
      *                                                                 12270000
           Perform Varying Ind-WS                                       12280000
                   From  +1              By    +1                       12290000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         12300000
                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    12310011
                                         =     R115IPA0-In-Table-Version12320011
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    12330011
                                         =     FK-OAKO-FinInst-ID       12340000
                     and WS-DB2-Contract-Type (Ind-WS)                  12350000
                                         =     FK-TFMC-Contr-Type       12360000
                     and WS-DB2-Contract-No (Ind-WS)                    12370000
                                         =     FK-TFMC-Contr-No         12380000
                     and WS-DB2-CA-Currency (Ind-WS)                    12390000
                                         =     FK-TFCA-Currency         12400000
                     and WS-DB2-PA-Seq-No (Ind-WS)                      12410000
                                         =     TFPA-Seq-No )            12420000
           End-Perform                                                  12430000
      *                                                                 12440000
           Evaluate True                                                12450000
             When Ind-WS                 >     W-Max-Occ-WS-Tab         12460000
               Continue                                                 12470000
      *                                                                 12480000
             When other                                                 12490000
               Initialize                      WS-DB2-Row (Ind-WS)      12500000
      *                                                                 12510000
           End-Evaluate                                                 12520000
      *                                                                 12530000
           .                                                            12540000
      *################################################################*12550000
       N100-Fetch-Fin-Inst-ID            Section.                       12560000
      *                                                                 12570000
           Move  W-Fin-Inst-No (1:4)     To    W-Tmp-Konsern-Nr         12580000
      *                                                                 12590000
           If  Not R5879010-Versjon                                     12600000
           or  R5879010-In-Konsernnr     Not = W-Tmp-Konsern-Nr         12610000
      *                                                                 12620000
               Initialize                      R5879010-Konsern         12630000
               Set   R5879010-Versjon    To    True                     12640000
               Set   R5879010-In-Select  To    True                     12650000
               Move  W-Tmp-Konsern-Nr    To    R5879010-In-Konsernnr    12660000
               Call  'F5879010'          Using R5879010-Konsern         12670000
                                               R7919999-Error-Area      12680000
               End-Call                                                 12690000
               If  Not R7919999-Return-OK                               12700000
                   Move  'N101'          To    R7919999-Paragraph       12710000
                   Perform Z900-Abend                                   12720000
               End-If                                                   12730000
      *                                                                 12740000
           End-If                                                       12750000
      *                                                                 12760000
           Move  R5879010-Ut-KO-Konsern-Id                              12770000
                                         To    W-Fin-Inst-ID            12780000
      *                                                                 12790000
           .                                                            12800000
      *################################################################*12810000
       N200-Fetch-Fin-Inst-No            Section.                       12820000
      *                                                                 12830000
           If  Not R5879010-Versjon                                     12840000
           or  R5879010-In-Konsern-ID    Not = W-Fin-Inst-ID            12850000
      *                                                                 12860000
               Initialize                      R5879010-Konsern         12870000
               Set   R5879010-Versjon    To    True                     12880000
               Set   R5879010-In-Select  To    True                     12890000
               Move  W-Fin-Inst-ID       To    R5879010-In-Konsern-ID   12900000
               Call  'F5879010'          Using R5879010-Konsern         12910000
                                               R7919999-Error-Area      12920000
               End-Call                                                 12930000
               If  Not R7919999-Return-OK                               12940000
                   Move  'N201'          To    R7919999-Paragraph       12950000
                   Perform Z900-Abend                                   12960000
               End-If                                                   12970000
      *                                                                 12980000
           End-If                                                       12990000
      *                                                                 13000000
           Move  R5879010-Ut-KO-Konsernnummer                           13010000
                                         To    W-Tmp-Konsern-Nr         13020000
           Move  W-Tmp-Konsern-Nr        To    W-Fin-Inst-No            13030000
      *                                                                 13040000
           .                                                            13050000
      *################################################################*13060000
       ZI00-Conv-Input-Version           Section.                       13070000
      *                                                                 13080000
      * Version control.                                                13090000
      * If conversion is needed, we call the conversion module.         13100000
      *                                                                 13110000
           Set   R115IPA0-Version        To    True                     13120000
           Move  Length                  Of    R115IPA0-Part-Amount     13130000
                                         To    W-IO-Length              13140000
      *                                                                 13150000
           Evaluate True                                                13160000
             When L-Ext-IO-Area (1:8)    =     R115IPA0-Version-No      13170000
             and  Length                 Of    L-Ext-IO-Area            13180000
                                         Not < W-IO-Length              13190000
               Move  L-Ext-IO-Area (1:W-IO-Length)                      13200000
                                         To    W-Int-IO-Area            13210000
      *                                                                 13220000
             When Other                                                 13230000
               Call  'F115I999'                                         13240000
                   Using By Content      'F115IPA0 '                    13250000
                                         'INPUT '                       13260000
                         By Reference    L-Ext-IO-Area                  13270000
                                         W-Int-IO-Area                  13280000
                                         R7919999-Error-Area            13290000
               End-Call                                                 13300000
      *                                                                 13310000
               If  R7919999-Return-Abend                                13320000
                   Move  'ZI03'          To    R7919999-Paragraph       13330000
                   Perform Z900-Abend                                   13340000
               End-If                                                   13350000
      *                                                                 13360000
           End-Evaluate                                                 13370000
      *                                                                 13380000
           .                                                            13390000
      *################################################################*13400000
       ZO00-Conv-Output-Version          Section.                       13410000
      *                                                                 13420000
      * Version control.                                                13430000
      * If conversion is needed, we call the conversion module.         13440000
      *                                                                 13450000
           Evaluate True                                                13460000
             When L-Ext-IO-Area (1:8)    =     R115IPA0-Version-No      13470000
             and  Length                 Of    L-Ext-IO-Area            13480000
                                         Not < W-IO-Length              13490000
               Move  W-Int-IO-Area       To    L-Ext-IO-Area            13500000
                                                         (1:W-IO-Length)13510000
      *                                                                 13520000
             When Other                                                 13530000
               Call  'F115I999'                                         13540000
                   Using By Content      'F115IPA0 '                    13550000
                                         'OUTPUT '                      13560000
                         By Reference    L-Ext-IO-Area                  13570000
                                         W-Int-IO-Area                  13580000
                                         R7919999-Error-Area            13590000
               End-Call                                                 13600000
      *                                                                 13610000
               If  R7919999-Return-Abend                                13620000
                   Move  'ZO01'          To    R7919999-Paragraph       13630000
                   Perform Z900-Abend                                   13640000
               End-If                                                   13650000
      *                                                                 13660000
           End-Evaluate                                                 13670000
      *                                                                 13680000
           .                                                            13690000
      *################################################################*13700000
       Z000-Error-Message                Section.                       13710000
      *                                                                 13720000
           Set   R7918030-Version        To    True                     13730000
      *                                                                 13740000
           Move  'TF'                    To    R7918030-In-System-ID    13750000
           Move  R115X000-Fin-Inst-No    To    R7918030-In-Fin-Inst-No  13760000
           Move  R115X000-FI-Language-639-1                             13770000
                                         To    R7918030-In-Language     13780000
           If  R115X000-Trace-On                                        13790000
               Set   R7918030-In-Log-Yes To    True                     13800000
           End-If                                                       13810000
      *                                                                 13820000
           Call  'F7918030'              Using R7918030-ErrorMessage    13830000
           End-Call                                                     13840000
      *                                                                 13850000
           Move  R7918030-Out-MessageText                               13860000
                                         To    R7919999-Message         13870000
      *                                                                 13880000
           .                                                            13890000
      *################################################################*13900000
       Z900-Abend                        Section.                       13910000
      *                                                                 13920000
           If  R7919999-Return-Code      Not   Numeric                  13930000
           or  Not R7919999-Return-Abend                                13940000
               Move  +0                  To    R7919999-Module-Ind      13950000
           End-If                                                       13960000
      *                                                                 13970000
           Add   +1                      To    R7919999-Module-Ind      13980000
      *                                                                 13990000
           If  R7919999-Module-Ind       Not >                          14000000
                             ( Length    Of    R7919999-Module-Tab      14010000
                             / Length    Of    R7919999-Module-Element )14020000
               Move  'F115IPA0'          To    R7919999-Module-Name     14030000
                                                   (R7919999-Module-Ind)14040000
               Move  R7919999-Paragraph  To    R7919999-Module-Para     14050000
                                                   (R7919999-Module-Ind)14060000
           End-If                                                       14070000
      *                                                                 14080000
           Set   R7919999-Return-Abend   To    TRUE                     14090000
      *                                                                 14100000
           Goback.                                                      14110000

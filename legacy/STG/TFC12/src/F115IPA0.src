      *                                                                 02450000
      *################################################################.02460000
       Procedure Division                Using L-Ext-IO-Area            02470000
                                               R7919999-Error-Area.     02480000
      *                                                                 02490000
       A000-Main                         Section.                       02500000
      *                                                                 02510000
           Perform B000-Initialize                                      02520000
      *                                                                 02530000
           Evaluate True                                                02540000
             When SW-IA-Initialize                                      02550000
               Continue                                                 02560000
      *                                                                 02570000
             When Other                                                 02580000
               Perform ZI00-Conv-Input-Version                          02590000
               Perform C000-Interface                                   02600000
               Perform ZO00-Conv-Output-Version                         02610000
      *                                                                 02620000
           End-Evaluate                                                 02630000
      *                                                                 02640000
           Goback.                                                      02650000
      *################################################################*02660000
       B000-Initialize                   Section.                       02670000
      *                                                                 02680000
           Set   R7919999-Return-OK      To    True                     02690000
      *                                                                 02700000
           Evaluate True                                                02710000
             When L-Ext-IO-Area (1:10)   =     'INITIALIZE'             02720000
               Set   Sw-IA-Initialize    To    True                     02730000
             When Other                                                 02740000
               Move  Space               To    W-Input-Action           02750000
           End-Evaluate                                                 02760000
      *                                                                 02770000
           Compute  W-Max-Occ-WS-Tab                                    02780000
               =    Length               Of    WS-DB2-Table             02790000
               /    Length               Of    WS-DB2-Row               02800000
      *                                                                 02810000
           If  Sw-IA-Initialize                                         02820000
           or  WS-DB2-Row-Status (1)     Not   Numeric                  02830000
               Initialize                      W-Storage                02840000
               Move  +0                  To    Ind-WS-Put               02850000
           End-If                                                       02860000
      *                                                                 02870000
           If  WC-Row-No                 Not   Numeric                  02880000
           or  WC-Total-No-Of-Rows       Not   Numeric                  02890000
               Initialize                      WC-Counters              02900000
           End-If                                                       02910000
      *                                                                 02920000
           Evaluate True                                                02930000
             When Not R115X000-Is-Initiated                             02940000
               Initialize                      R115X000-External-Data   02950000
             When Not R115X000-Version                                  02960000
               Initialize                      R7918030-ErrorMessage    02970000
               Move  'GL-VERSION-INVALID'                               02980000
                                         To    R7918030-In-MessageCode  02990000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)03000000
               Move  R115X000-Version-No To R7918030-In-Variable-Data(1)03010000
               Move  'VAR2'              To R7918030-In-Variable-Key (2)03020000
               Move  'R115X000'          To R7918030-In-Variable-Data(2)03030000
               Perform Z000-Error-Message                               03040000
               Move  'B001'              To    R7919999-Paragraph       03050000
               Perform Z900-Abend                                       03060000
           End-Evaluate                                                 03070000
      *                                                                 03080000
           .                                                            03090000
      *################################################################.03100000
       C000-Interface                    Section.                       03110000

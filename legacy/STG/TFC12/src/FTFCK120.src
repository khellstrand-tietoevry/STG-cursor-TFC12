      *################################################################*08280001
      * Check dependencies against databas fields.                     *08290001
      *                                                                *08300001
      * Here we perform all nesecarry control , befor return to the    *08310001
      * H-module.                                                      *08320001
      *                                                                *08330001
      * Add Perform statements to other sections that contain the      *08340001
      * actual controls.                                               *08350001
      *----------------------------------------------------------------*08360001
      *<META E000-CONTROL-BASE>                                         08370001
       E000-Control-Base                 Section.                       08380001
      *                                                                 08390001
      *</META>                                                          08400001
      *                                                                 08410001
           Perform E100-Initial-Checks                                  08420001
      *    Continue                                                     08430001
      *                                                                 08440001
           .                                                            08450001
      *                                                                 08460001
      *<META E000-CONTROL-BASE-EX>                                      08470001
       E000-Control-Base-Ex.                                            08480001
           Exit.                                                        08490001
      *</META>                                                          08500001
                                                                        08510001
      *################################################################*08520001
       E100-Initial-Checks               Section.                       08530000
      *                                                                 08540000
           Initialize                          R115L050-Initial-Check   08550000
           Set   R115L050-Version        To    True                     08560000
      *                                                                 08570000
           Move  R400CH01-Function       To    R115L050-Function        08580000
           Move  R400CH01-Medium         To    R115L050-Medium          08590000
      *                                                                 08600000
           Move  RTFCE120-I-Fin-Inst-No-D                               08610000
                                         To    R115L050-Fin-Inst-No     08620000
           Move  RTFCE120-I-Contract-Type-D                             08630000
                                         To    R115L050-Contr-Type      08640000
           Move  RTFCE120-I-Contract-No-D                               08650000
                                         To    R115L050-Contr-No        08660000
      *                                                                 08670001
           If RTFCE120-I-Part-Amount-No-I =     'U'                     08680001
             Move  RTFCE120-I-Part-Amount-No-D                          08690000
                                         To    R115L050-PA-Seq-No       08700000
           End-If                                                       08710001
      *                                                                 08720000
           Move  RTFCE120-I-Operation-Type-D                            08730000
                                         To    R115L050-Operation-Type  08740000
      *                                                                 08750000
           Move  RTFCE120-B-Last-Saved-Date-D                           08760000
                                         To    R115L050-Last-Update-TX  08770000
      *                                                                 08780000
           Call  'F115L050'              Using R115L050-Initial-Check   08790000
                                               R7919999-Error-Area      08800000
           End-Call                                                     08810000
      *                                                                 08820000
           Evaluate True                                                08830000
             When R7919999-Return-Abend                                 08840000
               Move  'FM'                To    R400CH01-Message-Code    08850000
               Move  'E101'              To    R7919999-Paragraph       08860000
               Perform Z900-Abend                                       08870000
                                                                        08880000
             When R7919999-Return-Error                                 08890000
               Move  'FM'                To    R400CH01-Message-Code    08900000
               Move  'E102'              To    R7919999-Paragraph       08910000
               Perform Z700-Error-AE                                    08920000
                                                                        08930000
             When R7919999-Return-OK                                    08940000
               Continue                                                 08950000
                                                                        08960000
           End-Evaluate                                                 08970000
           .                                                            08980000
       E100-Initial-Checks-Ex.                                          08990000
           Exit.                                                        09000000
                                                                        09010000
      *################################################################*09020001
      * Set Warning status                                             *09030001
      *                                                                *09040001
      *----------------------------------------------------------------*09050001
      *<META Z600-ERROR-AW>                                             09060001
       Z600-Error-AW                     Section.                       09070001
      *                                                                 09080001
           Set   R7919999-Return-Warning To    True                     09090001
           Move  'FTFCK120'              To    R400CH01-Message-Text    09100001
           .                                                            09110001
      *                                                                 09120001
       Z600-Error-AW-Ex.                                                09130001
           Exit.                                                        09140001
      *</META>                                                          09150001
                                                                        09160001
      *################################################################*09170001
      * Syntax Error status                                            *09180001
      *                                                                *09190001
      *----------------------------------------------------------------*09200001
      *<META Z700-ERROR-AE>                                             09210001
       Z700-Error-AE                     Section.                       09220001
      *                                                                 09230001
           Set   R7919999-Return-Error   To    True                     09240001
           If    R400CH01-Message-Code   =     'FM'                     09250001
                 String   'FTFCK120'           Delimited By Size        09260001
                          ': '                 Delimited By Size        09270001
                       R7919999-Message        Delimited By Size        09280001
                                         Into  R400CH01-Message-Text    09290001
                 End-String                                             09300001
           Else                                                         09310001
                 Move  'FTFCK120'        To    R400CH01-Message-Text    09320001
           End-If                                                       09330001
           .                                                            09340001
      *                                                                 09350001
       Z700-Error-AE-Ex.                                                09360001
           Goback.                                                      09370001
      *</META>                                                          09380001
                                                                        09390001
      *################################################################*09400001
      * Severe error. Will genereate USER-ABEND in STG when the        *09410001
      * function is executed in batch.                                 *09420001
      *----------------------------------------------------------------*09430001
      *<META Z800-ERROR-AS>                                             09440001
       Z800-Error-AS                     Section.                       09450001
      *                                                                 09460001
           Set   R7919999-Return-Abend   To    True                     09470001
           If    R400CH01-Message-Code   =     'FM'                     09480001
                 String   'FTFCK120'           Delimited By Size        09490001
                          ': '                 Delimited By Size        09500001
                       R7919999-Message        Delimited By Size        09510001
                                         Into  R400CH01-Message-Text    09520001
                 End-String                                             09530001
           Else                                                         09540001
                 Move  'FTFCK120'        To    R400CH01-Message-Text    09550001
           End-If                                                       09560001
           .                                                            09570001
      *                                                                 09580001
       Z800-Error-AS-Ex.                                                09590001
           Goback.                                                      09600001
      *</META>                                                          09610001
                                                                        09620001
      *################################################################*09630001
      * Severe error. Will genereate USER-ABEND in STG when the        *09640001
      * function is executed in batch.                                 *09650001
      *----------------------------------------------------------------*09660001
      *<META Z900-ABEND>                                                09670001
       Z900-Abend                        Section.                       09680001
      *                                                                 09690001
           Set   R7919999-Return-Abend   To    True                     09700001
           If    R400CH01-Message-Code   =     'FM'                     09710001
                 String   'FTFCK120'           Delimited By Size        09720001
                          ': '                 Delimited By Size        09730001
                       R7919999-Message        Delimited By Size        09740001
                                         Into  R400CH01-Message-Text    09750001
                 End-String                                             09760001
           Else                                                         09770001
                 Move  'FTFCK120'        To    R400CH01-Message-Text    09780001
           End-If                                                       09790001
      *                                                                 09800001
      *----------------------------------------------------------------*09810001
      *                                                                 09820001
           If  R7919999-Return-Code      Not   Numeric                  09830001
           or  Not R7919999-Return-Abend                                09840001
               Move  +0                  To    R7919999-Module-Ind      09850001
           End-If                                                       09860001
           Add   +1                      To    R7919999-Module-Ind      09870001
           If  R7919999-Module-Ind       Not >                          09880001
                             ( Length    Of    R7919999-Module-Tab      09890001
                             / Length    Of    R7919999-Module-Element )09900001
               Move  'FTFCK120'          To    R7919999-Module-Name     09910001

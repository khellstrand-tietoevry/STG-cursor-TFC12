               88  SW-Euro-To-No              Value 'N', ' '.           01330043
               88  SW-Euro-To-Yes             Value 'Y'.                01340043
             10  W-Euro-To-Rate          Pic S9(08)V9(06)        Comp-3.01350043
             10  W-Euro-To-Denomination  Pic S9(05)              Comp-3.01360043
                                                                        01370043
             10  SW-Euro                 Pic  X(01).                    01380040
               88  SW-Euro-No                 Value 'N', ' '.           01390040
               88  SW-Euro-Yes                Value 'Y'.                01400040
             10  W-Euro-Rate             Pic S9(08)V9(06)        Comp-3.01410040
             10  W-Euro-Denomination     Pic S9(05)              Comp-3.01420040
      *                                                                 01430040
           05  W-Work-Info.                                             01440045
             10  W-Currency              Pic  X(03).                    01450045
             10  W-Rate                  Pic S9(08)V9(06)        Comp-3.01460045

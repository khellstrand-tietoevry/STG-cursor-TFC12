             When WS-Accept-ILC                                         01490035
             When WS-Accept-Coll-ELC                                    01500040
               Perform D000-Process-Charge-List                         01510032
      *                                                                 01520016
             When WS-Settle-ILC                                         01530035
               Perform C200-Read-Part-Amount                            01540008
               Perform D000-Process-Charge-List                         01550008
      *                                                                 01560003
             When WS-Dispose                                            01570036
             When WS-Return                                             01580035
             When WS-Expire                                             01590045
             When WS-Settle-Coll                                        01600035
             When WS-Settle-ELC                                         01610035
             When WS-Settle-Agent                                       01620035
               Perform D000-Process-Charge-List                         01630008
      *                                                                 01640000
             When other                                                 01650000

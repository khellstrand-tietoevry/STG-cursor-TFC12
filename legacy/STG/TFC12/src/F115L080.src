             When R7919999-Return-Error                                 04880007
               Continue                                                 04890012
      *                                                                 04900007
             When R7919999-Return-OK                                    04910007
               Continue                                                 04920007
      *                                                                 04930007
           End-Evaluate                                                 04940007
           .                                                            04950007
      *################################################################*04960005
       H200-Update-Main-Charge.                                         04970008
      *                                                                 04980007
           Perform H210-Read-1st-TF-CH                                  04990012
      *                                                                 05000012
           Perform until R7919999-Return-Error                          05010012
             Perform H230-Delete-TF-CH                                  05020023
             Perform H220-Read-Next-TF-CH                               05030012
           End-Perform                                                  05040012
      *                                                                 05050012
           Initialize                          R7919999-Error           05060012
           .                                                            05070007
      *################################################################*05080007
       H210-Read-1st-TF-CH.                                             05090012
      *                                                                 05100026
           Initialize                          R115ICH0-Main-Charge     05110026
           Set   R115ICH0-Version        To    True                     05120026
           Set   R115ICH0-In-Work        To    True                     05130026
           Set   R115ICH0-In-Get-1st     To    True                     05140026
      *                                                                 05150007
           Move  R115L080-In-Fin-Inst-No To    R115ICH0-In-Fin-Inst-No  05160007
           Move  R115L080-In-Contract-Type                              05170007
                                         To    R115ICH0-In-Contract-Type05180007
           Move  R115L080-In-Contract-No To    R115ICH0-In-Contract-No  05190049
           Move  R115L070-Charge-Type(W-Ind)                            05200007
                                         To    R115ICH0-In-Charge-Type  05210007
      *                                                                 05220007
           Perform H250-Call-DBI-TF-CH                                  05230012
           .                                                            05240007
      *################################################################*05250007
       H220-Read-Next-TF-CH.                                            05260012
      *                                                                 05270012
           Initialize                          R115ICH0-Main-Charge     05280026
           Set   R115ICH0-Version        To    True                     05290026
           Set   R115ICH0-In-Work        To    True                     05300026
           Set   R115ICH0-In-Get-Next    To    True                     05310012
      *                                                                 05320026
           Move  R115L080-In-Fin-Inst-No To    R115ICH0-In-Fin-Inst-No  05330026
           Move  R115L080-In-Contract-Type                              05340026
                                         To    R115ICH0-In-Contract-Type05350026
           Move  R115L080-In-Contract-No To    R115ICH0-In-Contract-No  05360049
           Move  R115L070-Charge-Type(W-Ind)                            05370026
                                         To    R115ICH0-In-Charge-Type  05380026
      *                                                                 05390026
           Perform H250-Call-DBI-TF-CH                                  05400012
           .                                                            05410012
      *################################################################*05420012
       H230-Delete-TF-CH.                                               05430023
      *                                                                 05440026
           Set   R115ICH0-In-Work        To    True                     05450026
           Set   R115ICH0-In-Delete      To    True                     05460026
      *                                                                 05470007
           Move  R115L080-In-Contract-No To    R115ICH0-In-Contract-No  05490026
      *                                                                 05500025
           Move  R115ICH0-CA-Currency    To    R115ICH0-In-CA-Currency  05510025
           Move  R115ICH0-PA-Seq-No      To    R115ICH0-In-PA-Seq-No    05520025
           Move  R115ICH0-RP-Role-Type   To    R115ICH0-In-RP-Role-Type 05530025
           Move  R115ICH0-Charge-Type    To    R115ICH0-In-Charge-Type  05540025
           Move  R115ICH0-CH-Seq-No      To    R115ICH0-In-CH-Seq-No    05550025
      *                                                                 05560007
           Perform H250-Call-DBI-TF-CH                                  05570012
           .                                                            05580007
      *################################################################*05590007
       H250-Call-DBI-TF-CH.                                             05600012
      *                                                                 05610007
           Call  'F115ICH0'              Using R115ICH0-Main-Charge     05620007
                                               R7919999-Error-Area      05630007
           End-Call                                                     05640007
      *                                                                 05650007
           Evaluate True                                                05660007
             When R7919999-Return-Abend                                 05670007
               Move  'H231'              To    R7919999-Paragraph       05680008
               Perform Z900-Abend                                       05690007
      *                                                                 05700007
             When R7919999-Return-Error                                 05710007
               Continue                                                 05720012
      *                                                                 05730007
             When R7919999-Return-OK                                    05740007
               Continue                                                 05750007
      *                                                                 05760007
           End-Evaluate                                                 05770007
           .                                                            05780007
      *################################################################*05790007
       ZI00-Konv-Input-Version.                                         05800000
      *                                                                 05810000
      * Version control.                                                05820000
      * If conversion is needed, we call the conversion module.         05830000
      *                                                                 05840000
           Set   R115L080-Version        To    True                     05850000
           Move  Length                  Of    R115L080-Comp-Charge     05860000
                                         To    W-IO-Length              05870000
      *                                                                 05880000
           Evaluate True                                                05890000
             When L-Ext-IO-Area (1:8)    =     R115L080-Version-No      05900000
             and  Length                 Of    L-Ext-IO-Area            05910000
                                         Not < W-IO-Length              05920000
               Move  L-Ext-IO-Area (1:W-IO-Length)                      05930000
                                         To    W-Int-IO-Area            05940000
      *                                                                 05950000
             When Other                                                 05960000
               Call  'F115L999'                                         05970000
                   Using By Content      'F115L080 '                    05980000
                                         'INPUT '                       05990000
                         By Reference    L-Ext-IO-Area                  06000000
                                         W-Int-IO-Area                  06010000
                                         R7919999-Error-Area            06020000
               End-Call                                                 06030000
      *                                                                 06040000
               If  R7919999-Return-Abend                                06050000
                   Move  'ZI01'          To    R7919999-Paragraph       06060000
                   Perform Z900-Abend                                   06070000
               End-If                                                   06080000
      *                                                                 06090000
           End-Evaluate                                                 06100000
           .                                                            06110000
      *################################################################*06120000
       ZO00-Konv-Output-Version.                                        06130000
      *                                                                 06140000
      * Version control.                                                06150000
      * If conversion is needed, we call the conversion module.         06160000
      *                                                                 06170000
           Evaluate True                                                06180000
             When L-Ext-IO-Area (1:8)    =     R115L080-Version-No      06190000
             and  Length                 Of    L-Ext-IO-Area            06200000
                                         Not < W-IO-Length              06210000
               Move  W-Int-IO-Area       To    L-Ext-IO-Area            06220000
                                                         (1:W-IO-Length)06230000
      *                                                                 06240000
             When Other                                                 06250000
               Call  'F115L999'                                         06260000
                   Using By Content      'F115L080 '                    06270000
                                         'OUTPUT '                      06280000
                         By Reference    L-Ext-IO-Area                  06290000
                                         W-Int-IO-Area                  06300000
                                         R7919999-Error-Area            06310000
               End-Call                                                 06320000
      *                                                                 06330000
               If  R7919999-Return-Abend                                06340000
                   Move  'ZO01'          To    R7919999-Paragraph       06350000
                   Perform Z900-Abend                                   06360000
               End-If                                                   06370000
      *                                                                 06380000
           End-Evaluate                                                 06390000
           .                                                            06400000
      *################################################################*06410000
       Z000-Error-Message.                                              06420000
      *                                                                 06430000
           Set   R7918030-Version        To    True                     06440000
      *                                                                 06450000
           Move  'TF'                    To    R7918030-In-System-ID    06460000
           Move  R115X000-Fin-Inst-No    To    R7918030-In-Fin-Inst-No  06470000
           Move  R115X000-FI-Language-639-1                             06480000
                                         To    R7918030-In-Language     06490000
      *                                                                 06500000
           If  R115X000-Trace-On                                        06510000
               Set  R7918030-In-Log-Yes  To    True                     06520000
           End-If                                                       06530000
      *                                                                 06540000
           Call  'F7918030'              Using R7918030-ErrorMessage    06550000
           End-Call                                                     06560000
      *                                                                 06570000
           Move  R7918030-Out-MessageText                               06580000
                                         To    R7919999-Message         06590000
           .                                                            06600000
      *################################################################*06610000
       Z700-Error-AE.                                                   06620000
      *                                                                 06630000
           If  R7919999-Return-Code      Not   Numeric                  06640000
           or  Not R7919999-Return-Abend                                06650000
               Move  +0                  To    R7919999-Module-Ind      06660000
           End-If                                                       06670000
      *                                                                 06680000
           Add   +1                      To    R7919999-Module-Ind      06690000
      *                                                                 06700000
           If  R7919999-Module-Ind       Not >                          06710000
                             ( Length    Of    R7919999-Module-Tab      06720000
                             / Length    Of    R7919999-Module-Element )06730000
               Move  'F115L080'          To    R7919999-Module-Name     06740000
                                                   (R7919999-Module-Ind)06750000
               Move  R7919999-Paragraph  To    R7919999-Module-Para     06760000
                                                   (R7919999-Module-Ind)06770000
           End-If                                                       06780000
      *                                                                 06790000
           Set   R7919999-Return-Error   To    True                     06800000
      *                                                                 06810000
           Goback                                                       06820000
           .                                                            06830000
      *################################################################*06840000
       Z900-Abend.                                                      06850000
      *                                                                 06860000
           If  R7919999-Return-Code      Not   Numeric                  06870000
           or  Not R7919999-Return-Abend                                06880000
               Move  +0                  To    R7919999-Module-Ind      06890000
           End-If                                                       06900000
      *                                                                 06910000
           Add   +1                      To    R7919999-Module-Ind      06920000
      *                                                                 06930000
           If  R7919999-Module-Ind       Not >                          06940000
                             ( Length    Of    R7919999-Module-Tab      06950000
                             / Length    Of    R7919999-Module-Element )06960000
               Move  'F115L080'          To    R7919999-Module-Name     06970000
                                                   (R7919999-Module-Ind)06980000
               Move  R7919999-Paragraph  To    R7919999-Module-Para     06990000
                                                   (R7919999-Module-Ind)07000000
           End-If                                                       07010000
      *                                                                 07020000
           Set   R7919999-Return-Abend   To    TRUE                     07030000
      *                                                                 07040000
           Goback                                                       07050000
           .                                                            07060000

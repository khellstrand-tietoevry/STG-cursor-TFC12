                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    12870009
                                         =     R115IPC0-In-Table-Version12880009
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    12890009
                                         =     FK-OAKO-FinInst-ID       12900009
                     and WS-DB2-Contract-Type (Ind-WS)                  12910009
                                         =     FK-TFMC-Contr-Type       12920000
                     and WS-DB2-Contract-No (Ind-WS)                    12930000
                                         =     FK-TFMC-Contr-No         12940000
                     and WS-DB2-CA-Currency (Ind-WS)                    12950000
                                         =     FK-TFCA-Currency         12960000
                     and WS-DB2-PA-Seq-No (Ind-WS)                      12970000
                                         =     FK-TFPA-Seq-No           12980000
                     and WS-DB2-Role-Type (Ind-WS)                      12990000
                                         =     FK-KFTY-Role-Type        13000001
                     and WS-DB2-CT-Type (Ind-WS)                        13010001
                                         =     FK-TFCT-Type )           13020013
           End-Perform                                                  13030000
      *                                                                 13040000
           Evaluate True                                                13050000
             When Ind-WS                 >     W-Max-Occ-WS-Tab         13060000
               Continue                                                 13070000
